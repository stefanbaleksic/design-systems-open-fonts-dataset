title: "Design System Fonts Dataset"
version: "1.0.0"
doi: 10.5281/zenodo.24354032
url: "https://stefanbaleksic.github.io/design-systems-open-fonts-dataset/"
repository-code: "https://github.com/stefanbaleksic/design-systems-open-fonts-dataset"
type: dataset
license: CC-BY-4.0
authors:
  - family-names: Aleksić
    given-names: Stefan B.
